      "parameters": {
        "promptType": "define",
        "text": "=Write a LinkedIn post about: {{ $json.Topic }}\n\nRules:\n- Line one is the hook: one short sentence that makes a professional stop scrolling.\n- 120-150 words in total.\n- Short paragraphs of 1-2 sentences, with a blank line between them.\n- Exactly one call to action, near the end.\n- At most 3 hashtags, on the last line.\n\nReturn the post only - no title, no preamble, no quotation marks.",
        "needsFallback": true,
        "options": {
          "systemMessage": "You are a LinkedIn ghostwriter for a working professional.\nWrite in the first person, in plain, confident, conversational English.\nUse plain text only: no markdown, no bold, no bullet symbols.\nNever invent statistics, quotes, company names or personal stories. If a point needs evidence, keep it general rather than specific.\nUse at most 2 emojis, or none."
        }
      },
